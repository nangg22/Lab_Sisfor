# Neon PostgreSQL connection string (buat database development sendiri atau gunakan yang disepakati tim)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# Auth.js
NEXTAUTH_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Hanya diperlukan untuk membuat/reset akun Admin secara lokal.
ADMIN_EMAIL=admin@sisfor.uisi.ac.id
ADMIN_PASSWORD=ganti-dengan-password-lokal

# Email provider Resend (production reset password dan verifikasi email)
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=SIP-Lab <noreply@example.com>
